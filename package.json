    "test:sbari": "node --test tests/sbari-parser.test.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "mammoth": "1.12.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "twilio": "6.0.2"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "vite": "^5.0.0"
  }
}
