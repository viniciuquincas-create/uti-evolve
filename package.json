  "scripts": {
    "dev": "vite",
    "build": "node -e \"const{rmSync,existsSync}=require('fs');['node_modules/.vite','.vite'].forEach(p=>{try{rmSync(p,{recursive:true,force:true})}catch{}});\" && vite build",
